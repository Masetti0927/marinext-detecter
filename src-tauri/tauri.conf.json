{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "marine_detecter",
  "version": "0.1.0",
  "identifier": "com.masetti.marine_detecter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MarineXt Detector",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "python/main.py",
      "models/**/*",
      "python-runtime/**/*"
    ]
  }
}
